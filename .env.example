# Supabase project settings. Obtain these from the Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never add a NEXT_PUBLIC_ prefix to this or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# FedaPay sandbox settings. Keep private credentials server-side.
FEDAPAY_ENV=test
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_WEBHOOK_SECRET=
