# Supabase project settings. Obtain these from the Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional server-only key for future privileged server operations; not used by the app.
# Never put an anon/publishable key in this variable or expose a service-role key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL connections for Prisma (server-only; never use NEXT_PUBLIC_).
# URL-encode any reserved characters in the database password.
# Use the Supavisor transaction pooler for runtime database requests.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true"
# Use the direct connection when IPv6 is available. Otherwise use Supavisor's session
# pooler (port 5432) for Prisma CLI schema introspection on IPv4-only networks.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"

# FedaPay sandbox settings. Keep private credentials server-side.
FEDAPAY_ENV=test
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_WEBHOOK_SECRET=
