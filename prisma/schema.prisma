generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

model School {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singleton          Boolean              @unique @default(true)
  name               String
  slug               String               @unique
  countryCode        String               @default("BJ") @map("country_code") @db.Char(2)
  currency           String               @default("XOF") @db.Char(3)
  timezone           String               @default("Africa/Porto-Novo")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  academic_years     academic_years[]
  audit_events       audit_events[]
  fee_categories     fee_categories[]
  guardians          guardians[]
  notifications      notifications[]
  receipt_counters   receipt_counters[]
  school_classes     school_classes[]
  school_memberships school_memberships[]
  students           students[]

  @@map("schools")
  @@schema("public")
}

