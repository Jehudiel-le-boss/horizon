model academic_years {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id          String               @db.Uuid
  label              String
  starts_on          DateTime             @db.Date
  ends_on            DateTime             @db.Date
  status             academic_year_status @default(planned)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  schools            School               @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  enrollments        enrollments[]
  fee_configurations fee_configurations[]
  invoices           invoices[]
  payment_plans      payment_plans[]
  receipt_counters   receipt_counters?
  receipts           receipts[]

  @@unique([id, school_id])
  @@unique([school_id, label])
  @@schema("public")
}

